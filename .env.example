# Cloud Cost Optimization Agent Environment Variables
# Leave blank to use the deterministic fallback engine (no external API calls)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10.0

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Reports Directory
REPORTS_DIR=reports
